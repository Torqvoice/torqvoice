generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  /// The mobile a technician signs in with, and the number a workshop holds
  /// for whoever this is.
  ///
  /// Deliberately not unique. When a desk creates an account for a mechanic
  /// standing at the counter, a second workshop may create another for the
  /// same human, and neither should be able to block the other. Every lookup
  /// reaches it through a technician row and so is already scoped to one
  /// workshop; the number alone is never the question being asked.
  phone         String?
  image         String?
  isSuperAdmin  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  twoFactorEnabled Boolean   @default(false)
  termsAcceptedAt  DateTime?
  lastLogin        DateTime?
  lastSeen         DateTime?
  /// App version this user last saw/dismissed the update banner for.
  /// Null = never seeded (seeded silently on first load, no banner).
  lastSeenVersion  String?
  /// Per-user dashboard grid layout (card positions/sizes/hidden set).
  /// Null = default layout. Shape validated in dashboardLayoutActions.
  dashboardLayout  Json?

  sessions               Session[]
  accounts               Account[]
  pushDevices            PushDevice[]
  appSetupCodes          TechnicianSetupCode[]
  vehicles               Vehicle[]
  customers              Customer[]
  settings               AppSetting[]
  inventoryParts         InventoryPart[]
  quotes                 Quote[]
  customFieldDefinitions CustomFieldDefinition[]
  twoFactor              TwoFactor?
  passkeys               Passkey[]
  organizationMembers    OrganizationMember[]
  dashboardWidgets       DashboardWidget[]
  auditLogs              AuditLog[]
  technicians            Technician[]
  stockMovements         StockMovement[]
  tireWarehouses         TireWarehouse[]
  tireSets               TireSet[]
  tireSetAttachments     TireSetAttachment[]
  tireMeasurements       TireMeasurement[]
  tireMovements          TireMovement[]
  tireTreatments         TireTreatment[]

  @@map("users")
}

model AppSetting {
  id    String @id @default(cuid())
  key   String
  value String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("app_settings")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String    @unique
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}

model TwoFactor {
  id          String @id @default(cuid())
  secret      String
  backupCodes String
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor")
}

model Passkey {
  id           String   @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String   @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("passkeys")
}

model Vehicle {
  id                     String               @id @default(cuid())
  make                   String
  model                  String
  year                   Int
  vin                    String?
  licensePlate           String?
  color                  String?
  mileage                Int                  @default(0)
  fuelType               String?              @default("gasoline")
  transmission           String?              @default("automatic")
  engineSize             String?
  engineCode             String?
  purchaseDate           DateTime?
  purchasePrice          Float?
  imageUrl               String?
  isArchived             Boolean              @default(false)
  archiveReason          String?
  maintenanceDismissed   Boolean              @default(false)
  maintenanceDismissedAt DateTime?
  aiMessages             AiGeneratedMessage[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  serviceRecords    ServiceRecord[]
  notes             Note[]
  fuelLogs          FuelLog[]
  reminders         Reminder[]
  quotes            Quote[]
  recurringInvoices RecurringInvoice[]
  inspections       Inspection[]
  serviceRequests   ServiceRequest[]
  findings          VehicleFinding[]
  scheduledMessages ScheduledMessage[]
  tireSets          TireSet[]

  @@index([organizationId])
  @@map("vehicles")
}

model ServiceRecord {
  id              String    @id @default(cuid())
  title           String
  description     String?
  type            String    @default("maintenance")
  status          String    @default("completed")
  cost            Float     @default(0)
  mileage         Int?
  serviceDate     DateTime  @default(now())
  startDateTime   DateTime?
  endDateTime     DateTime?
  shopName        String?
  techName        String?
  parts           String?
  laborHours      Float?
  diagnosticNotes String?
  invoiceNotes    String?
  subtotal        Float     @default(0)
  taxRate         Float     @default(0)
  taxAmount       Float     @default(0)
  taxInclusive    Boolean   @default(false)
  totalAmount     Float     @default(0)
  invoiceNumber   String?
  invoiceDate     DateTime?
  invoiceDueDate  DateTime?
  discountType    String?
  discountValue   Float     @default(0)
  discountAmount  Float     @default(0)
  manuallyPaid    Boolean   @default(false)

  // Warranty tracking
  warrantyMonths    Int?
  warrantyMileage   Int?
  warrantyExpiresAt DateTime?
  warrantyNotes     String?

  publicToken  String?   @unique
  sharedAt     DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// First time this invoice reached the customer, by email or share link.
  /// Distinct from sharedAt, which tracks only the link and is cleared when
  /// the link is revoked; sending is not undone by withdrawing the link.
  sentAt DateTime?

  /// Set when an owner or admin deliberately reopens a locked document.
  /// Nullable rather than a boolean so the audit trail can show when, and the
  /// screen can say the document was reopened rather than never locked.
  editUnlockedAt   DateTime?
  editUnlockedById String?

  /// The stored set this job is about, when it came out of the tire hotel.
  /// Without it a tire-change work order says nothing about which tires, and
  /// the technician has to go and ask.
  tireSetId String?
  tireSet   TireSet? @relation(fields: [tireSetId], references: [id], onDelete: SetNull)

  /// Null for parts-only / counter sales; such records use customerId
  /// (or neither, for anonymous walk-in sales)
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// Direct customer for records without a vehicle. Vehicle-linked records
  /// leave this null and resolve the customer through the vehicle, so
  /// reassigning a vehicle keeps invoices following the vehicle's customer.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Set when the job came straight from an inspection, so the inspection can
  /// show what was raised from it. SetNull: deleting the inspection must not
  /// take the job — and its invoice — with it.
  inspectionId String?
  inspection   Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  /// Denormalized from the vehicle historically; now the canonical scope so
  /// records exist without a vehicle. Nullable to mirror Vehicle.organizationId.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  technicianId String?
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  /// Where in the shop the job is booked in: a lift, a ramp, an alignment
  /// stand. Independent of the technician, because a shop plans its bays and
  /// its people separately and the work board can lane by either.
  workBayId String?
  workBay   WorkBay? @relation(fields: [workBayId], references: [id], onDelete: SetNull)
  sortOrder Int      @default(0)

  partItems      ServicePart[]
  laborItems     ServiceLabor[]
  attachments    ServiceAttachment[]
  payments       Payment[]
  statusReports  StatusReport[]
  stockMovements StockMovement[]
  timeEntries    TimeEntry[]

  concerns           ServiceConcern[]
  discoveredFindings VehicleFinding[] @relation("FindingDiscoveredIn")
  resolvedFindings   VehicleFinding[] @relation("FindingResolvedIn")

  @@index([vehicleId])
  @@index([technicianId])
  @@index([workBayId])
  @@index([organizationId])
  @@index([customerId])
  @@index([inspectionId])
  @@map("service_records")
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("notes")
}

model FuelLog {
  id             String   @id @default(cuid())
  date           DateTime @default(now())
  mileage        Int
  gallons        Float
  pricePerGallon Float
  totalCost      Float
  isFillUp       Boolean  @default(true)
  station        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("fuel_logs")
}

model Reminder {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  dueMileage  Int?
  isCompleted Boolean   @default(false)
  /// Per-reminder notification channels, chosen when creating the reminder
  notifyInApp Boolean   @default(true)
  notifyEmail Boolean   @default(false)
  /// Set by the due-reminder cron once notified; cleared when dueDate changes
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// A reminder relates to a vehicle, a customer, or just the workshop
  /// (both null). organizationId is the canonical scope for all three.
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([customerId])
  @@index([organizationId])
  @@map("reminders")
}

/// One thing the customer asked about, in their words.
///
/// A job is a list of these rather than a single note, because that is how the
/// work actually divides: "it pulls right when braking" and "the aircon smells"
/// are two conversations, two diagnoses and two lines on the bill. Storing them
/// as one blob means the shop can answer one and quietly drop the other, which
/// is the single most common reason a car comes back.
///
/// This is the first of the trade's three Cs. The cause is a VehicleFinding
/// pointing back here, carrying its own notes and photographs; the correction
/// is the labour and parts on the job. Together they let the invoice explain
/// itself: you said this, we found that, we did this about it.
model ServiceConcern {
  id          String   @id @default(cuid())
  /// The customer's own words, kept as they said them.
  description String
  /// The order the customer raised them in, which is the order they care about.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serviceRecordId String
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)

  /// What the shop found when it went looking. Empty means nobody has answered
  /// this one yet, which is worth being able to ask about before closing a job.
  findings VehicleFinding[]

  @@index([serviceRecordId])
  @@map("service_concerns")
}

model VehicleFinding {
  id          String   @id @default(cuid())
  description String
  severity    String   @default("needs_work")
  status      String   @default("open")
  notes       String?
  imageUrls   String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  serviceRecordId String?
  serviceRecord   ServiceRecord? @relation("FindingDiscoveredIn", fields: [serviceRecordId], references: [id], onDelete: SetNull)

  resolvedServiceRecordId String?
  resolvedServiceRecord   ServiceRecord? @relation("FindingResolvedIn", fields: [resolvedServiceRecordId], references: [id], onDelete: SetNull)

  /// The customer concern this finding answers, if it answers one.
  ///
  /// Nullable because plenty of findings are things nobody asked about: the
  /// perished bush somebody noticed while the car was on the lift. Those are
  /// worth just as much, they just are not part of the story the customer
  /// started. SetNull rather than Cascade because a finding is a fact about
  /// the vehicle and outlives the concern that prompted the look.
  concernId String?
  concern   ServiceConcern? @relation(fields: [concernId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([serviceRecordId])
  @@index([concernId])
  @@map("vehicle_findings")
}

model Customer {
  id             String   @id @default(cuid())
  /// Human-facing customer number: auto-assigned sequentially on create,
  /// editable afterwards. Unique per organization (nulls allowed for
  /// legacy customers).
  customerNumber String?
  name           String
  email          String?
  phone          String?
  address        String?
  company        String?
  taxId          String?
  taxExempt      Boolean  @default(false)
  notes          String?
  telegramChatId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  vehicles          Vehicle[]
  quotes            Quote[]
  smsMessages       SmsMessage[]
  telegramMessages  TelegramMessage[]
  whatsappMessages  WhatsappMessage[]
  customerSessions  CustomerSession[]
  scheduledMessages ScheduledMessage[]
  serviceRequests   ServiceRequest[]

  serviceRecords ServiceRecord[]
  reminders      Reminder[]
  tireSets       TireSet[]

  @@unique([organizationId, customerNumber])
  @@index([organizationId])
  @@map("customers")
}

model Payment {
  id         String   @id @default(cuid())
  amount     Float
  date       DateTime @default(now())
  method     String   @default("other")
  note       String?
  provider   String?
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  serviceRecordId String
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)

  @@index([serviceRecordId])
  @@map("payments")
}

model ServiceAttachment {
  id               String   @id @default(cuid())
  fileName         String
  fileUrl          String
  fileType         String
  fileSize         Int
  category         String   @default("diagnostic")
  description      String?
  includeInInvoice Boolean  @default(true)
  createdAt        DateTime @default(now())

  serviceRecordId String
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)

  @@index([serviceRecordId])
  @@map("service_attachments")
}

model ServicePart {
  id              String  @id @default(cuid())
  partNumber      String?
  name            String
  quantity        Float   @default(1)
  /// Unit of measure snapshotted from InventoryPart at pick time; null for
  /// free-text lines and legacy rows.
  unit            String?
  unitPrice       Float   @default(0)
  total           Float   @default(0)
  unitCost        Float   @default(0)
  markupPercent   Float   @default(0)
  inventoryPartId String?

  serviceRecordId String
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)

  @@index([serviceRecordId])
  @@map("service_parts")
}

model ServiceLabor {
  id          String @id @default(cuid())
  description String
  hours       Float  @default(0)
  rate        Float  @default(0)
  total       Float  @default(0)
  pricingType String @default("hourly")

  serviceRecordId String
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)

  @@index([serviceRecordId])
  @@map("service_labor")
}

model LaborPreset {
  id             String            @id @default(cuid())
  name           String
  description    String?
  isArchived     Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  userId         String
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          LaborPresetItem[]
  parts          LaborPresetPart[]

  @@index([organizationId])
  @@map("labor_presets")
}

model LaborPresetItem {
  id          String      @id @default(cuid())
  description String
  hours       Float       @default(0)
  rate        Float       @default(0)
  pricingType String      @default("hourly")
  sortOrder   Int         @default(0)
  presetId    String
  preset      LaborPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@index([presetId])
  @@map("labor_preset_items")
}

model LaborPresetPart {
  id              String  @id @default(cuid())
  name            String
  partNumber      String?
  quantity        Float   @default(1)
  /// Unit of measure snapshotted from InventoryPart at pick time.
  unit            String?
  unitPrice       Float   @default(0)
  inventoryPartId String?
  sortOrder       Int     @default(0)

  presetId String
  preset   LaborPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@index([presetId])
  @@map("labor_preset_parts")
}

model InventoryPart {
  id            String  @id @default(cuid())
  partNumber    String?
  barcode       String?
  name          String
  description   String?
  category      String?
  quantity      Float   @default(0)
  minQuantity   Float   @default(0)
  /// Unit of measure for `quantity` (e.g. "pcs", "l", "kg"). Free text,
  /// snapshotted onto part lines at pick time so invoices keep the unit the
  /// part had when it was billed.
  unit          String?
  unitCost      Float   @default(0)
  sellPrice     Float   @default(0)
  supplier      String?
  supplierPhone String?
  supplierEmail String?
  supplierUrl   String?
  imageUrl      String?
  location      String?
  isArchived    Boolean @default(false)

  /// Set when a low-stock alert has been sent for the current dip below
  /// `minQuantity`, and cleared once stock climbs back above it. This
  /// hysteresis is what stops a part that sits at zero from re-alerting on
  /// every check — it alerts once per descent, not once per run.
  lowStockAlertedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  gallery   StoredImage[]   @relation("InventoryPartImages")
  movements StockMovement[]

  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@map("inventory_parts")
}

/// Append-only audit trail of every change to InventoryPart.quantity.
///
/// Written inside the same transaction as the stock mutation itself, so the
/// ledger can never drift from the balance it describes. `quantityAfter` is
/// captured from the atomic `UPDATE ... RETURNING`, giving an exact running
/// balance even under concurrent writes.
model StockMovement {
  id String @id @default(cuid())

  /// Signed change in stock units (fractional allowed, e.g. 0.5 l).
  /// Negative = consumed, positive = restocked.
  delta         Float
  /// Part balance immediately after this movement was applied.
  quantityAfter Float
  /// Why the stock moved — see StockMovementReason in src/features/inventory/Lib/stockMovement.ts
  reason        String
  note          String?

  inventoryPartId String
  inventoryPart   InventoryPart @relation(fields: [inventoryPartId], references: [id], onDelete: Cascade)

  /// The job the part was used on. Kept on SetNull so history survives
  /// deletion of the service record — "where was this used" outlives the job.
  serviceRecordId String?
  serviceRecord   ServiceRecord? @relation(fields: [serviceRecordId], references: [id], onDelete: SetNull)

  /// Denormalised so history still reads correctly after a service record is
  /// deleted and serviceRecordId goes null.
  serviceRecordLabel String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([inventoryPartId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([serviceRecordId])
  @@map("stock_movements")
}

model StoredImage {
  id          String   @id @default(cuid())
  url         String
  fileName    String?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  inventoryPartId String?
  inventoryPart   InventoryPart? @relation("InventoryPartImages", fields: [inventoryPartId], references: [id], onDelete: Cascade)

  /// Condition photos taken when a tire is measured. Second parent on this
  /// model — an image belongs to exactly one of them.
  tireMeasurementId String?
  tireMeasurement   TireMeasurement? @relation("TireMeasurementImages", fields: [tireMeasurementId], references: [id], onDelete: Cascade)

  @@index([inventoryPartId])
  @@index([tireMeasurementId])
  @@map("stored_images")
}

model Quote {
  id              String    @id @default(cuid())
  quoteNumber     String?
  title           String
  description     String?
  status          String    @default("draft")
  validUntil      DateTime?
  subtotal        Float     @default(0)
  taxRate         Float     @default(0)
  taxAmount       Float     @default(0)
  taxInclusive    Boolean   @default(false)
  discountType    String?
  discountValue   Float     @default(0)
  discountAmount  Float     @default(0)
  totalAmount     Float     @default(0)
  notes           String?
  publicToken     String?
  sharedAt        DateTime?
  viewCount       Int       @default(0)
  lastViewedAt    DateTime?
  customerMessage String?
  convertedToId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Most recent time this quote reached the customer, by email or share
  /// link. Exists so an unlock is spent when the quote is issued again; the
  /// status alone cannot show that, because re-sending an accepted quote does
  /// not change it.
  sentAt DateTime?

  /// See ServiceRecord.editUnlockedAt.
  editUnlockedAt   DateTime?
  editUnlockedById String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// The stored set this quote is about, when it came out of the tire hotel.
  /// SetNull rather than Cascade: a quote already sent is a document the
  /// customer holds, and deleting the set must not erase it.
  tireSetId String?
  tireSet   TireSet? @relation(fields: [tireSetId], references: [id], onDelete: SetNull)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  inspectionId String?
  inspection   Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  partItems   QuotePart[]
  laborItems  QuoteLabor[]
  attachments QuoteAttachment[]

  @@index([organizationId])
  @@map("quotes")
}

model QuoteAttachment {
  id               String   @id @default(cuid())
  fileName         String
  fileUrl          String
  fileType         String
  fileSize         Int
  category         String   @default("image")
  description      String?
  includeInInvoice Boolean  @default(true)
  createdAt        DateTime @default(now())

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_attachments")
}

model QuotePart {
  id            String  @id @default(cuid())
  partNumber    String?
  name          String
  quantity      Float   @default(1)
