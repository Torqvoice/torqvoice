/// One WhatsApp message in either direction.
///
/// `provider` records which adapter carried it, because a workshop can switch
/// provider without its history becoming unreadable, and a status callback
/// arriving later has to find the row it belongs to.
model WhatsappMessage {
  id        String @id @default(cuid())
  direction String // "inbound" | "outbound"
  provider  String // "meta" | "twilio" | any adapter registered later

  /// E.164 without the "whatsapp:" prefix a provider may use on the wire.
  fromNumber String
  toNumber   String

  body String?

  /// Media the message carried. Inbound URLs may need the provider's
  /// credentials to fetch, so they are not necessarily public.
  mediaUrl      String?
  mediaType     String? // image | document | video | audio | sticker
  mediaFilename String?

  /// Set when the message had to go out as an approved template, which is the
  /// only thing WhatsApp allows outside the 24 hour service window.
  templateName String?

  status            String  @default("queued") // queued | sent | delivered | read | failed | received
  providerMessageId String?
  errorMessage      String?

  relatedEntityType String?
  relatedEntityId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, customerId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([providerMessageId])
  @@map("whatsapp_messages")
}

model Technician {
  id            String  @id @default(cuid())
  name          String
  color         String  @default("#3b82f6")
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)
  dailyCapacity Int     @default(480)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  loginCodes     TechnicianLoginCode[]
  serviceRecords ServiceRecord[]
  inspections    Inspection[]
  statusReports  StatusReport[]
  timeEntries    TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("technicians")
}

/// One stretch of a technician actually working on a job, as clocked from the
/// technician app.
///
/// Deliberately separate from `ServiceRecord.startDateTime` / `endDateTime`:
/// those are the work board's planned slot, one pair per job, owned by whoever
/// schedules the day. This is what happened, many rows per job, one per person
/// per stretch. A job worked on Monday, parked for parts and finished Thursday
/// by someone else is two entries, and neither of them is the booking.
///
/// `endedAt` null means the clock is still running. At most one open entry per
/// technician is enforced in the API rather than the schema, because "open"
/// is not a value a partial unique index can express portably.
model TimeEntry {
  id String @id @default(cuid())

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  /// Cached on stop so reports do not recompute across millions of rows, and
  /// so a correction to the timestamps stays visible against what was billed.
  durationMinutes Int?

  /// What the technician typed when stopping, if anything.
  note String?

  /// "app" | "web" | "manual". A manually corrected entry is not the same
  /// evidence as one clocked live, and Arbeitszeiterfassung cares about that.
  source String @default("app")

  /// Set when someone edited the times after the fact, so the audit trail can
  /// show the entry is no longer purely as-clocked.
  editedAt       DateTime?
  editedByUserId String?

  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  serviceRecordId String
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([technicianId, startedAt])
  @@index([serviceRecordId])
  @@index([organizationId, startedAt])
  /// Finding the technician's open entry is the hottest query in the app: it
  /// runs on every launch and every job screen.
  @@index([technicianId, endedAt])
  @@map("time_entries")
}

/// A phone that has asked to be told about its technician's work.
///
/// Keyed on the Expo push token rather than on the user, because the unit that
/// receives a notification is a device: one technician may carry a personal
/// phone and a shared bench tablet, and a shared tablet may be signed into by
/// several people over a week. Both cases have to work.
///
/// The token is a routing address, not a secret, but it is still deleted on
/// sign-out: a device that has signed out must stop receiving a workshop's job
/// details, and expiry alone would leave a window where it still did.
/// A one-time code that puts a technician's phone onto a workshop.
///
/// Typing a URL and a password is the worst moment in the app, and it lands on
/// the person least equipped for it: a technician with dirty hands, on a
/// phone, being watched. The desk shows a QR instead and the phone reads it.
///
/// It is a bearer credential in a picture, so it is deliberately short-lived,
/// single-use, and bound to one person in one workshop. It exchanges for a
/// normal session and is then dead; it is never itself a way to authenticate.
/// A one-time code that signs a technician back in.
///
/// Modelled on CustomerSmsCode, which does the same job for the customer
/// portal: org-scoped, single use, short-lived. The organisation is not
/// optional and is never inferred from the phone number. A technician's phone
/// is only ever looked up inside the workshop their app already belongs to,
/// so nothing here can reach across workshops even if a person works at two.
model TechnicianLoginCode {
  id String @id @default(cuid())

  /// SHA-256 of the digits. The code exists in a text message and in the
  /// technician's head, and nowhere that can be read back out of a database.
  codeHash String

  /// How it was sent, so the app can say "check your messages" or "check your
  /// email" rather than guessing on the technician's behalf.
  channel String

  /// Wrong guesses so far. Six digits is a million, which a rate limiter alone
  /// does not protect: this burns the code after a handful of attempts.
  attempts Int @default(0)

  expiresAt DateTime
  usedAt    DateTime?

  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, technicianId])
  @@index([expiresAt])
  @@map("technician_login_codes")
}

model TechnicianSetupCode {
  id String @id @default(cuid())

  /// SHA-256 of the code. The code itself is shown once, on the screen that
  /// asked for it, and is never written down anywhere it could be read back.
  codeHash String @unique

  expiresAt DateTime
  /// Set on redemption. Kept rather than deleted so a second scan can say the
  /// code was already used, which is a different problem from a wrong code.
  usedAt    DateTime?

  /// Who the code signs in.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Who issued it, for the audit trail. Not a relation: the issuer may be
  /// removed from the workshop later and that must not delete the record.
  issuedByUserId String

  createdAt DateTime @default(now())

  @@index([organizationId, expiresAt])
  @@index([userId])
  @@map("technician_setup_codes")
}

model PushDevice {
  id String @id @default(cuid())

  /// Expo push token, unique across the estate. A reinstall issues a new one
  /// and the old becomes invalid, which is why sends prune on rejection.
  token String @unique

  /// "ios" | "android". Only used to explain failures in logs.
  platform String

  /// Set false when Expo reports the token as dead, rather than deleting, so
  /// a flapping device does not churn rows.
  isActive Boolean @default(true)

  /// Last time the app confirmed this token still belongs to this user, so a
  /// device that stops checking in can be aged out.
  lastSeenAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
  @@index([organizationId])
  @@map("push_devices")
}

/// A physical place work happens: a lift, a wash bay, an alignment rack. Shops
/// plan by bay as often as by person — the bay is the scarce resource, and a
/// technician moves between them during a day. The work board can group its
/// lanes by either, so both are first-class.
model WorkBay {
  id            String  @id @default(cuid())
  name          String
  color         String  @default("#64748b")
  isActive      Boolean @default(true)
  /// Ordering on the board, left to right. Shops name bays by position
  /// ("Bay 1", "Lift 2") and expect them in that order, not alphabetically.
  sortOrder     Int     @default(0)
  /// Bookable minutes per day, mirroring Technician.dailyCapacity so the board
  /// can show utilisation for whichever lane grouping is on.
  dailyCapacity Int     @default(480)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  serviceRecords ServiceRecord[]
  inspections    Inspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("work_bays")
}

model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  action    String
  entity    String?
  entityId  String?
  message   String?
  metadata  Json?
  ip        String?
  userAgent String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, timestamp(sort: Desc)])
  @@index([userId, timestamp(sort: Desc)])
  @@index([action, timestamp(sort: Desc)])
  @@map("audit_logs")
}

model CustomerSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organizationId String

  @@index([token])
  @@index([customerId, organizationId])
  @@map("customer_sessions")
}

model CustomerMagicLink {
  id             String    @id @default(cuid())
  token          String    @unique
  email          String
  organizationId String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([token])
  @@map("customer_magic_links")
}

model CustomerSmsCode {
  id String @id @default(cuid())

  /// SHA-256 of the digits, not the digits.
  ///
  /// The code reaches the customer in a text message and lives in their head
  /// for a minute. It has no business also sitting in a table where reading a
  /// row hands over somebody's portal session.
  code String

  /// Wrong guesses so far. Six digits is a million, which sounds like plenty
  /// and is not: limiting by address does nothing about a hundred machines
  /// sharing the work. Five attempts against one code makes the space
  /// irrelevant, because the code is gone long before the guessing arrives.
  attempts Int @default(0)

  phone          String
  organizationId String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([phone, organizationId])
  @@index([organizationId])
  @@map("customer_sms_codes")
}

model ServiceRequest {
  id            String    @id @default(cuid())
  description   String
  preferredDate DateTime?
  status        String    @default("pending")
  adminNotes    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  organizationId String

  @@index([organizationId, status])
  @@index([customerId])
  @@map("service_requests")
}

model AiGeneratedMessage {
  id        String   @id @default(cuid())
  vehicleId String
  type      String // "summary" | "common_issues" | etc.
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, type])
  @@map("ai_generated_messages")
}

model AiChat {
  id        String   @id @default(cuid())
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId         String
  organizationId String

  messages AiChatMessage[]

  @@index([organizationId, userId, updatedAt(sort: Desc)])
  @@map("ai_chats")
}

model AiChatMessage {
  id        String   @id @default(cuid())
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  chatId String
  chat   AiChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("ai_chat_messages")
}

model StatusReport {
  id               String    @id @default(cuid())
  title            String?
  message          String?   @db.Text
  videoUrl         String?
  videoFileName    String?
  publicToken      String    @unique
  status           String    @default("draft") // draft | published | sent | viewed
  sentVia          String? // email, sms, telegram (comma-separated)
  sentAt           DateTime?
  viewedAt         DateTime?
  customerFeedback String?   @db.Text
  feedbackAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  serviceRecordId String
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  technicianId String?
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  @@index([serviceRecordId])
  @@index([organizationId])
  @@index([publicToken])
  @@index([expiresAt])
  @@map("status_reports")
}

model ReportSchedule {
  id          String    @id @default(cuid())
  name        String    @default("Scheduled Report")
  frequency   String // "daily" | "weekly" | "monthly" etc.
  dateRange   String    @default("last30d") // "last1d" | "last7d" | "last30d" | "ytd" | "allTime" etc.
  sections    String // JSON array of section keys
  recipients  String // JSON array of user IDs
  nextRunDate DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)
  lastRunAt   DateTime?
  runCount    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdById String

  @@index([organizationId])
  @@index([nextRunDate, isActive])
  @@map("report_schedules")
}

/// A message the workshop lines up to go out on a given day and time, through
/// whichever channel suits the customer. One-off by default; a frequency other
/// than "once" reschedules itself after each send, the way ReportSchedule does.
model ScheduledMessage {
  id      String  @id @default(cuid())
  channel String // "email" | "sms" | "telegram" | "in_app"
  subject String? // email only
  body    String

  /// Where it goes when no customer is attached, or when the workshop typed an
  /// address by hand. Falls back to the customer's email/phone/chat id.
  recipient String?

  status       String    @default("scheduled") // scheduled | sent | failed | cancelled
  sendAt       DateTime
  frequency    String    @default("once") // once | daily | weekly | biweekly | monthly | yearly
  endDate      DateTime?
  lastRunAt    DateTime?
  sentAt       DateTime?
  runCount     Int       @default(0)
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  createdById String

  @@index([organizationId, sendAt])
  @@index([status, sendAt])
  @@map("scheduled_messages")
}

model Webhook {
  id              String    @id @default(cuid())
  name            String
  url             String
  secret          String
  events          String // JSON array of event names; "*" matches all
  isActive        Boolean   @default(true)
  description     String?
  lastTriggeredAt DateTime?
  lastSuccessAt   DateTime?
  lastFailureAt   DateTime?
  failureCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdById String

  deliveries WebhookDelivery[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String    @id @default(cuid())
  event        String
  payload      String // JSON-stringified event payload as sent
  status       String    @default("pending") // pending | success | failed | retrying
  statusCode   Int?
  responseBody String?
  errorMessage String?
  attempt      Int       @default(0)
  maxAttempts  Int       @default(5)
  nextRetryAt  DateTime?
  deliveredAt  DateTime?
  durationMs   Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  webhookId String
  webhook   Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt(sort: Desc)])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------------------
// Tire hotel
//
// Seasonal tire storage. Opt-in per organization via the `tireHotel.enabled`
// app setting — every model here stays empty and every route stays hidden
// until a workshop switches it on.
//
// Capacity is counted in individual tires rather than sets, because a shelf
// that holds eight 15" tires does not hold eight 21" tires, and customers
// store anything from a single spare to a five-wheel set. Counting the real
// unit is the only thing that stays true in every market.
// ---------------------------------------------------------------------------

/// A physical building or room holding tire storage. Most workshops have one;
/// multi-site operators have several.
model TireWarehouse {
  id         String  @id @default(cuid())
  name       String
  address    String?
  notes      String?
  /// Preselected when checking tires in. Exactly one per organization.
  isDefault  Boolean @default(false)
  isArchived Boolean @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  locations TireLocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("tire_warehouses")
}

/// One addressable storage slot: a shelf, a rack level, a pallet, a floor
/// square. The workshop names its own geography, so `zone`/`rack`/`shelf` are
/// free text rather than a fixed hierarchy — "Room B / Rack 4 / Shelf 2" and
/// "Container 1 / -- / Pallet 7" both fit.
model TireLocation {
  id String @id @default(cuid())

  /// Short human code used on labels and when directing a technician,
  /// e.g. "B-04-2". Unique within a warehouse.
  code String

  zone     String?
  rack     String?
  shelf    String?
  position String?

  /// How many individual tires fit here. The shelf overview divides stored
  /// tires by this to show how full the location is.
  capacity Int @default(8)

  notes      String?
  isArchived Boolean @default(false)

  warehouseId String
  warehouse   TireWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tireSets  TireSet[]
  movesFrom TireMovement[] @relation("TireMovementFrom")
  movesTo   TireMovement[] @relation("TireMovementTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, code])
  @@index([organizationId])
  @@index([warehouseId, isArchived])
  @@map("tire_locations")
}

/// A group of tires stored together for one vehicle. Usually four, but the
/// count is explicit so a pair or a five-wheel set works the same way.
model TireSet {
  id String @id @default(cuid())

  /// Sequential per organization, shown to staff and printed on labels.
  reference String?

  /// summer | winter | all_season | other — see TIRE_SEASONS in
  /// src/features/tire-hotel/Lib/tireConstants.ts
  season  String  @default("summer")
  /// Studded winter tires are legal in some markets and banned in others, so
  /// this is a flag on the season rather than a season of its own.
  studded Boolean @default(false)

  brand          String?
  model          String?
  /// Free text so every regional notation fits: "225/45R17", "P225/45R17 94V",
  /// "31x10.5R15".
  size           String?
  /// DOT / TIN week-year code used to judge tire age.
  dotCode        String?
  loadSpeedIndex String?

  /// Mounted on rims, which changes both handling and what a shelf holds.
  withRims Boolean @default(false)
  rimType  String?
  /// Tire pressure monitoring sensors present — they need care on refit.
  hasTpms  Boolean @default(false)

  /// Individual tires in this set. Drives every capacity calculation.
  quantity Int @default(4)

  /// stored | released | disposed — see TIRE_SET_STATUSES
  status String @default("stored")

  notes String?

  /// Where it physically sits. Null once released to the customer.
  locationId String?
  location   TireLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  checkedInAt  DateTime?
  checkedOutAt DateTime?

  measurements   TireMeasurement[]
  movements      TireMovement[]
  treatments     TireTreatment[]
  attachments    TireSetAttachment[]
  quotes         Quote[]
  serviceRecords ServiceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([locationId])
  @@index([vehicleId])
  @@index([customerId])
  @@map("tire_sets")
}

/// Condition of one tire at one moment. Kept as history rather than current
/// state so wear between seasons is visible, and so a damage dispute has a
/// dated record behind it.
/// A photo or document held against a stored set: a picture of a kerbed rim,
/// a damage report, the customer's written agreement to store them.
///
/// Deliberately the same shape as ServiceAttachment, because that is where
/// these end up when the set is billed. Copying a row between two models with
/// the same fields cannot lose anything in translation, and the invoice PDF
/// already knows how to render one.
model TireSetAttachment {
  id       String @id @default(cuid())
  fileName String
  fileUrl  String
  fileType String
  fileSize Int

  /// What the technician wants said about it, e.g. "kerbing on the near side".
  /// Travels onto the invoice as the caption under the image.
  description String?

  /// Whether it should reach the customer's invoice when this set is billed.
  /// On by default: a photo taken at check-in is usually taken to be shown.
  includeInInvoice Boolean @default(true)

  sortOrder Int @default(0)

  tireSetId String
  tireSet   TireSet @relation(fields: [tireSetId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tireSetId])
  @@index([organizationId])
  @@map("tire_set_attachments")
}

model TireMeasurement {
  id String @id @default(cuid())

  /// front_left | front_right | rear_left | rear_right | spare | unspecified
  position String @default("unspecified")

  /// Always stored in millimetres. The UI converts to 32nds of an inch for
  /// workshops on imperial units, so one number means the same thing in
  /// every market.
  treadDepthMm Float?
  /// Always stored in bar. Converted to psi/kPa for display.
  pressureBar  Float?

  /// good | fair | replace — see TIRE_CONDITIONS
  condition String  @default("good")
  damage    String?
  notes     String?

  tireSetId String
  tireSet   TireSet @relation(fields: [tireSetId], references: [id], onDelete: Cascade)

  /// Groups the four readings taken during one check-in or inspection so the
  /// history reads as events rather than loose numbers.
  movementId String?
  movement   TireMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)

  measuredById String?
  measuredBy   User?   @relation(fields: [measuredById], references: [id], onDelete: SetNull)

  images StoredImage[] @relation("TireMeasurementImages")

  measuredAt DateTime @default(now())

  @@index([tireSetId, measuredAt(sort: Desc)])
  @@index([movementId])
  @@map("tire_measurements")
}

/// Every physical handling of a set: arrival, departure, a move between
/// shelves, disposal. This is the storage audit trail — "where has this been
/// and who touched it" has to outlive the set's current row.
model TireMovement {
  id String @id @default(cuid())

  /// check_in | check_out | relocate | dispose — see TIRE_MOVEMENT_TYPES
  type String

  /// Denormalised location codes so history still reads correctly after a
  /// shelf is renamed or deleted.
  fromCode String?
  toCode   String?

  fromLocationId String?
  fromLocation   TireLocation? @relation("TireMovementFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)

  toLocationId String?
  toLocation   TireLocation? @relation("TireMovementTo", fields: [toLocationId], references: [id], onDelete: SetNull)

  note String?

  tireSetId String
  tireSet   TireSet @relation(fields: [tireSetId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  performedById String?
  performedBy   User?   @relation(fields: [performedById], references: [id], onDelete: SetNull)

  measurements TireMeasurement[]

  createdAt DateTime @default(now())

  @@index([tireSetId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("tire_movements")
}

/// Work a set needs before it goes back on the car, or before it goes on the
/// shelf: washing, balancing, a TPMS service.
///
/// A task with a state rather than a flag on the set, because the tire
/// department's real question is "what is left to do on this one", and a
/// boolean cannot answer that once someone has started. Recording who
/// finished it also settles the "was this washed?" conversation at pickup.
model TireTreatment {
  id String @id @default(cuid())

  /// wash_tires | wash_rims | balance | tpms_service | new_valves | repair
  /// — see TREATMENT_TYPES
  type String

  /// pending | done | skipped — see TREATMENT_STATUSES
  status String @default("pending")

  notes String?

  tireSetId String
  tireSet   TireSet @relation(fields: [tireSetId], references: [id], onDelete: Cascade)

  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation(fields: [completedById], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per kind of work per set: asking for a wash twice is the same
  /// request, not two.
  @@unique([tireSetId, type])
  @@index([organizationId, status])
  @@map("tire_treatments")
}
