# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/backups
# testing
/coverage
/plans
# next.js
/.next/
/out/
.claude

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# uploaded files
/public/uploads
/data/uploads/*
!/data/uploads/.gitkeep

# restic's index cache and the Restore Explorer's working files, per workshop
/data/restic-cache
/data/restore-explore
/data/restore-tmp

# end-to-end tests
/e2e/.auth
/e2e/.data
/test-results
/playwright-report
/blob-report
/playwright/.cache
